# Backend API base URL. Defaults to http://localhost:5000 in dev,
# https://nahidperfume-backend.onrender.com in production if unset.
VITE_API_URL=

# Google reCAPTCHA v3 site key (public, safe to expose in the frontend bundle).
# Leave blank to disable — checkout/contact will submit without a token and
# the backend will accept them unchecked (see backend/.env.example).
VITE_RECAPTCHA_SITE_KEY=
