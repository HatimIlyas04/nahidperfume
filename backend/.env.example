# ── Database ──────────────────────────────────────────────
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# ── Server ────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Auth ──────────────────────────────────────────────────
# Required. Long random string, no fallback exists anymore for security.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ── CORS ──────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins, e.g.:
# ALLOWED_ORIGINS=https://www.nahidperfumes.com,https://nahidperfumes.com
ALLOWED_ORIGINS=

# ── Cloudinary (image/video uploads) ─────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── WhatsApp notifications (UltraMsg) ─────────────────────────
ULTRAMSG_INSTANCE_ID=
ULTRAMSG_TOKEN=
# Comma-separated E.164 numbers to alert on new orders
ULTRAMSG_ADMIN_NUMBERS=

# ── Admin email notifications ─────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ADMIN_NOTIFICATION_EMAIL=

# ── Google reCAPTCHA v3 (checkout + contact form) ─────────────
# Get keys at https://www.google.com/recaptcha/admin — leave blank to disable
# (requests are allowed through unchecked, exactly like WhatsApp/email above).
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5
